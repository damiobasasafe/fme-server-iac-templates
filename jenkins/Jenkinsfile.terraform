// Dami - FME Flow Terraform Infrastructure Pipeline
// Provisions FME Flow distributed infrastructure on AWS using Terraform

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'prod'],
            description: 'Target environment to deploy to'
        )
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to perform'
        )
        string(
            name: 'CORE_AMI_ID',
            defaultValue: '',
            description: 'FME Core AMI ID (from Packer pipeline). Leave blank to use value in tfvars.'
        )
        string(
            name: 'ENGINE_AMI_ID',
            defaultValue: '',
            description: 'FME Engine AMI ID (from Packer pipeline). Leave blank to use value in tfvars.'
        )
    }

    environment {
        TF_DIR        = 'AWS/terraform'
        TF_VAR_FILE   = "AWS/terraform/envs/${params.ENVIRONMENT}.tfvars"
        AWS_REGION    = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
    }

    stages {
        stage('Validate') {
            steps {
                sh 'terraform version'
                sh 'aws sts get-caller-identity'
                script {
                    if (params.ACTION == 'destroy' && params.ENVIRONMENT == 'prod') {
                        input message: 'You are about to DESTROY PRODUCTION. Are you absolutely sure?',
                              ok: 'Yes, destroy production'
                    }
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir(env.TF_DIR) {
                    sh """
                        terraform init \
                            -backend-config="key=fmeflow/${params.ENVIRONMENT}/terraform.tfstate" \
                            -reconfigure \
                            -upgrade
                    """
                    sh "terraform workspace select ${params.ENVIRONMENT} || terraform workspace new ${params.ENVIRONMENT}"
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    string(credentialsId: 'dami-tf-ad-admin-pw',   variable: 'TF_VAR_ad_admin_pw'),
                    string(credentialsId: 'dami-tf-db-admin-user',  variable: 'TF_VAR_db_admin_user'),
                    string(credentialsId: 'dami-tf-db-admin-pw',    variable: 'TF_VAR_db_admin_pw')
                ]) {
                    dir(env.TF_DIR) {
                        script {
                            def amiVars = ''
                            if (params.CORE_AMI_ID) {
                                amiVars += " -var 'fme_core_image_id=${params.CORE_AMI_ID}'"
                            }
                            if (params.ENGINE_AMI_ID) {
                                amiVars += " -var 'fme_engine_image_id=${params.ENGINE_AMI_ID}'"
                            }

                            sh """
                                terraform plan \
                                    -var-file='envs/${params.ENVIRONMENT}.tfvars' \
                                    -var 'ad_admin_pw=\${TF_VAR_ad_admin_pw}' \
                                    -var 'db_admin_user=\${TF_VAR_db_admin_user}' \
                                    -var 'db_admin_pw=\${TF_VAR_db_admin_pw}' \
                                    ${amiVars} \
                                    -out=tfplan \
                                    -detailed-exitcode || true
                            """
                        }
                    }
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir(env.TF_DIR) {
                    sh 'terraform apply -auto-approve tfplan'
                    script {
                        env.ALB_DNS = sh(
                            script: "terraform output -raw alb_dns_name 2>/dev/null || echo ''",
                            returnStdout: true
                        ).trim()
                        if (env.ALB_DNS) {
                            echo "FME Flow URL: http://${env.ALB_DNS}/fmeserver"
                        }
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'dami-tf-ad-admin-pw',   variable: 'TF_VAR_ad_admin_pw'),
                    string(credentialsId: 'dami-tf-db-admin-user',  variable: 'TF_VAR_db_admin_user'),
                    string(credentialsId: 'dami-tf-db-admin-pw',    variable: 'TF_VAR_db_admin_pw')
                ]) {
                    dir(env.TF_DIR) {
                        script {
                            def amiVars = ''
                            if (params.CORE_AMI_ID) {
                                amiVars += " -var 'fme_core_image_id=${params.CORE_AMI_ID}'"
                            }
                            if (params.ENGINE_AMI_ID) {
                                amiVars += " -var 'fme_engine_image_id=${params.ENGINE_AMI_ID}'"
                            }

                            sh """
                                terraform destroy \
                                    -var-file='envs/${params.ENVIRONMENT}.tfvars' \
                                    -var 'ad_admin_pw=\${TF_VAR_ad_admin_pw}' \
                                    -var 'db_admin_user=\${TF_VAR_db_admin_user}' \
                                    -var 'db_admin_pw=\${TF_VAR_db_admin_pw}' \
                                    ${amiVars} \
                                    -auto-approve
                            """
                        }
                    }
                }
            }
        }

        stage('Output Summary') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir(env.TF_DIR) {
                    sh 'terraform output'
                    script {
                        if (env.ALB_DNS) {
                            writeFile file: 'deploy-output.env', text: """ENVIRONMENT=${params.ENVIRONMENT}
ALB_DNS=${env.ALB_DNS}
FME_FLOW_URL=http://${env.ALB_DNS}/fmeserver
CORE_AMI_ID=${params.CORE_AMI_ID}
ENGINE_AMI_ID=${params.ENGINE_AMI_ID}
"""
                        }
                    }
                    archiveArtifacts artifacts: 'deploy-output.env', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            dir(env.TF_DIR) {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo "Terraform ${params.ACTION} completed for [${params.ENVIRONMENT}]"
        }
        failure {
            echo "Terraform ${params.ACTION} FAILED for [${params.ENVIRONMENT}]. Check logs above."
        }
    }
}
