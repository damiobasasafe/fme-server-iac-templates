// =============================================================================
// FME Flow Project Sync Pipeline
// =============================================================================
// Promotes an FME Flow Project from one environment to another.
//
// What is an FME Flow Project?
//   A Project is FME Flow's deployment bundle. It contains workspaces,
//   automations, schedules, and connection definitions packaged as a single
//   .fsproject file. Exporting and importing a project is how you move
//   FME work items between environments in a controlled, repeatable way.
//
// What this pipeline does:
//   1. Validates parameters and checks connectivity + auth (pre-flight)
//   2. Downloads the named project from the source FME Flow environment
//   3. Uploads the .fsproject to the target FME Flow environment
//   4. Verifies the project is visible in the target before finishing
//
// Required Jenkins credentials (one per environment):
//   dami-fmeflow-dev-token         - FME Flow API token for dev
//   dami-fmeflow-staging-token     - FME Flow API token for staging
//   dami-fmeflow-prod-token        - FME Flow API token for prod
//   dami-fmeflow-cicd-deploy-token - FME Flow API token for cicd-deploy
//
// How to generate an API token:
//   FME Flow UI → username (top right) → User Settings → Manage Tokens → Generate
//   IMPORTANT: When generating the token, do NOT enable custom permissions.
//   Leave the permissions as "inherit from user" (the default). Tokens with
//   custom permissions that exclude repositories will get 403 on project upload.
//
// Encryption key requirement:
//   FME Flow encrypts named connection passwords with a per-instance JCEKS key
//   stored in C:\ProgramData\Safe Software\FMEFlow\key\fme_flow_key.jceks.
//   For project promotion to work across environments, source and target must
//   share the same fme_flow_key.jceks. This is an infrastructure concern — sync
//   the key as part of provisioning (e.g. store in SSM Parameter Store and write
//   it on instance startup before FME Flow services start).
//   Do NOT copy fme_flow_transmission.jceks between environments — that key
//   is used for internal component communication and is instance-specific.
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'SOURCE_ENV',
            choices: ['cicd-deploy', 'dev', 'staging'],
            description: 'Environment to export the project FROM. Must be a running FME Flow instance with the project already published.'
        )
        choice(
            name: 'TARGET_ENV',
            choices: ['staging', 'prod', 'cicd-deploy'],
            description: 'Environment to import the project INTO. The project will be created or replaced here.'
        )
        string(
            name: 'PROJECT_NAME',
            defaultValue: '',
            description: 'Exact name of the FME Flow project to promote. Must match the project name in the source environment.'
        )
        string(
            name: 'PROJECT_ID',
            defaultValue: '',
            description: 'Optional: FME Flow project UUID from the project page URL. Used as fallback if name-based export fails.'
        )
        booleanParam(
            name: 'OVERWRITE',
            defaultValue: true,
            description: 'Overwrite the project if it already exists in the target environment.'
        )
    }

    environment {
        FME_CLI     = 'fmeflow'
        EXPORT_FILE = "${params.SOURCE_ENV}-${params.PROJECT_NAME ?: 'project'}.fsproject"

        // FME Flow base URLs per environment — update these after each Terraform deployment
        DEV_URL         = 'http://dami-fmeflow-dev-alb-210390386.us-east-1.elb.amazonaws.com'
        STAGING_URL     = 'http://dami-fmeflow-staging-alb-2096266007.us-east-1.elb.amazonaws.com'
        PROD_URL        = 'http://cicd-deploy-prod-alb.us-east-1.elb.amazonaws.com'
        CICD_DEPLOY_URL = 'http://dami-fmeflow-dev-alb-210390386.us-east-1.elb.amazonaws.com'
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.PROJECT_NAME?.trim()) {
                        error 'PROJECT_NAME is required. Enter the exact name of the FME Flow project to promote.'
                    }
                    if (params.SOURCE_ENV == params.TARGET_ENV) {
                        error "SOURCE_ENV and TARGET_ENV cannot be the same (both set to '${params.SOURCE_ENV}')."
                    }
                    if (params.TARGET_ENV == 'prod') {
                        input message: "You are promoting '${params.PROJECT_NAME}' to PRODUCTION from ${params.SOURCE_ENV}. Review the project in ${params.SOURCE_ENV} before continuing.",
                              ok: 'Confirm promotion to prod'
                    }
                    echo "Promoting '${params.PROJECT_NAME}' from ${params.SOURCE_ENV} → ${params.TARGET_ENV}"
                }
            }
        }

        stage('Pre-flight Checks') {
            // Verifies connectivity and auth before doing anything.
            // Catches the two most common failure modes early:
            //   1. Environment unreachable (ALB down, instance not healthy)
            //   2. Token invalid / expired / has custom permissions (403 or 401)
            // Both of these used to surface as cryptic failures mid-pipeline.
            steps {
                script {
                    def sourceUrl = getEnvUrl(params.SOURCE_ENV)
                    def targetUrl = getEnvUrl(params.TARGET_ENV)

                    // --- Connectivity ---
                    echo "Checking source connectivity: ${sourceUrl}"
                    def sourceOk = sh(
                        script: "curl -sf --max-time 15 '${sourceUrl}/fmeapiv4/healthcheck/liveness' > /dev/null && echo OK || echo FAIL",
                        returnStdout: true
                    ).trim()
                    if (sourceOk != 'OK') {
                        error """\
Source environment (${params.SOURCE_ENV}) is not reachable.
URL: ${sourceUrl}/fmeapiv4/healthcheck/liveness
Check that the FME Flow instance is running and the ALB is healthy."""
                    }

                    echo "Checking target connectivity: ${targetUrl}"
                    def targetOk = sh(
                        script: "curl -sf --max-time 15 '${targetUrl}/fmeapiv4/healthcheck/liveness' > /dev/null && echo OK || echo FAIL",
                        returnStdout: true
                    ).trim()
                    if (targetOk != 'OK') {
                        error """\
Target environment (${params.TARGET_ENV}) is not reachable.
URL: ${targetUrl}/fmeapiv4/healthcheck/liveness
Check that the FME Flow instance is running and the ALB is healthy."""
                    }

                    // --- Token validation ---
                    // Calls GET /fmeapiv4/projects with the token. This uses the same
                    // permission scope as project upload, so it will catch custompermissions
                    // issues (403) and expired/invalid tokens (401) before we run anything.
                    echo "Validating source token (dami-fmeflow-${params.SOURCE_ENV}-token)..."
                    withCredentials([string(credentialsId: "dami-fmeflow-${params.SOURCE_ENV}-token", variable: 'FME_TOKEN')]) {
                        def code = sh(
                            script: "curl -s --max-time 15 -H 'Authorization: fmetoken token=\$FME_TOKEN' '${sourceUrl}/fmeapiv4/projects?limit=1' -o /dev/null -w '%{http_code}'",
                            returnStdout: true
                        ).trim()
                        checkTokenResponse(code, params.SOURCE_ENV, 'source')
                    }

                    echo "Validating target token (dami-fmeflow-${params.TARGET_ENV}-token)..."
                    withCredentials([string(credentialsId: "dami-fmeflow-${params.TARGET_ENV}-token", variable: 'FME_TOKEN')]) {
                        def code = sh(
                            script: "curl -s --max-time 15 -H 'Authorization: fmetoken token=\$FME_TOKEN' '${targetUrl}/fmeapiv4/projects?limit=1' -o /dev/null -w '%{http_code}'",
                            returnStdout: true
                        ).trim()
                        checkTokenResponse(code, params.TARGET_ENV, 'target')
                    }

                    echo "Pre-flight checks passed."
                }
            }
        }

        stage('Setup FME Flow CLI') {
            steps {
                script {
                    def installed = sh(
                        script: 'fmeflow --version 2>/dev/null && echo OK || echo MISSING',
                        returnStdout: true
                    ).trim()
                    if (installed.contains('MISSING')) {
                        echo 'FME Flow CLI not found. Installing via pip...'
                        sh 'pip3 install fmeflow-cli --quiet'
                        sh 'fmeflow --version'
                        echo 'FME Flow CLI installed.'
                    } else {
                        echo "FME Flow CLI already installed: ${installed}"
                    }
                }
            }
        }

        stage('Export Project from Source') {
            // Downloads the project as an .fsproject file.
            // Strategy:
            //   1. Try by PROJECT_NAME
            //   2. If that fails and PROJECT_ID is provided, fall back to ID
            //   3. Otherwise fail with a self-diagnosing error message
            steps {
                script {
                    def sourceUrl = getEnvUrl(params.SOURCE_ENV)
                    def credId    = "dami-fmeflow-${params.SOURCE_ENV}-token"

                    withCredentials([string(credentialsId: credId, variable: 'FME_TOKEN')]) {
                        sh "${env.FME_CLI} login ${sourceUrl} --token \$FME_TOKEN"

                        def byName = sh(
                            script: "${env.FME_CLI} projects download --name '${params.PROJECT_NAME}' -f '${env.EXPORT_FILE}' 2>&1 && echo __SUCCESS__ || echo __FAILED__",
                            returnStdout: true
                        ).trim()
                        echo byName

                        if (!byName.contains('__SUCCESS__')) {
                            if (params.PROJECT_ID?.trim()) {
                                echo "Name-based download failed. Trying project ID '${params.PROJECT_ID}'..."
                                sh "${env.FME_CLI} projects download --id '${params.PROJECT_ID}' -f '${env.EXPORT_FILE}'"
                            } else {
                                error """\
Export failed: project '${params.PROJECT_NAME}' not found in ${params.SOURCE_ENV}.
Possible causes:
  1. The project name has different casing or spacing.
     Fix: copy the exact name from FME Flow UI → Projects.
  2. The project does not exist in ${params.SOURCE_ENV} yet.
     Fix: publish the project to ${params.SOURCE_ENV} first.
To bypass: paste the project UUID from the FME Flow project page URL into the PROJECT_ID parameter."""
                            }
                        }

                        def size = sh(script: "du -sh '${env.EXPORT_FILE}' | cut -f1", returnStdout: true).trim()
                        echo "Export complete. File: ${env.EXPORT_FILE} (${size})"
                    }
                }
            }
        }

        stage('Import Project to Target') {
            // Uploads the .fsproject to the target environment.
            // --quick submits the import task and returns immediately; the verify
            // stage below polls for completion so we avoid the session timeout
            // that causes 401 during long imports.
            //
            // Named connection passwords are NOT included in .fsproject files.
            // After the first import into a new environment you need to re-enter
            // connection passwords via FME Flow UI → Connections.
            //
            // If the import task fails with "encrypted data that cannot be decrypted",
            // that means source and target have different fme_flow_key.jceks files.
            // See the header comment for how to fix this at the infrastructure level.
            steps {
                script {
                    def targetUrl = getEnvUrl(params.TARGET_ENV)
                    def credId    = "dami-fmeflow-${params.TARGET_ENV}-token"
                    def overwrite = params.OVERWRITE ? '--overwrite' : ''

                    withCredentials([string(credentialsId: credId, variable: 'FME_TOKEN')]) {
                        sh "${env.FME_CLI} login ${targetUrl} --token \$FME_TOKEN"

                        echo "Uploading '${env.EXPORT_FILE}' to ${params.TARGET_ENV}..."
                        def uploadOut = sh(
                            script: "${env.FME_CLI} projects upload -f '${env.EXPORT_FILE}' ${overwrite} --quick 2>&1",
                            returnStdout: true
                        ).trim()
                        echo uploadOut

                        // Extract task ID so the verify stage can poll it
                        def taskIdMatch = (uploadOut =~ /task submitted with id:\s*(\d+)/)
                        if (taskIdMatch) {
                            env.IMPORT_TASK_ID = taskIdMatch[0][1]
                            echo "Import task ID: ${env.IMPORT_TASK_ID}"
                        } else {
                            echo "Could not extract task ID from upload output — verify stage will check by project name only."
                        }
                    }
                }
            }
        }

        stage('Verify Promotion') {
            // Confirms the project is visible in the target after import.
            // If --quick was used, the import may still be in progress; this
            // stage retries for up to 90 seconds to handle that.
            steps {
                script {
                    def targetUrl = getEnvUrl(params.TARGET_ENV)
                    def credId    = "dami-fmeflow-${params.TARGET_ENV}-token"

                    withCredentials([string(credentialsId: credId, variable: 'FME_TOKEN')]) {
                        sh "${env.FME_CLI} login ${targetUrl} --token \$FME_TOKEN"

                        // Poll for up to 90 seconds (9 × 10 s) to allow the import task to settle
                        def verified = false
                        for (int attempt = 1; attempt <= 9; attempt++) {
                            def result = sh(
                                script: "${env.FME_CLI} projects --name '${params.PROJECT_NAME}' --json 2>&1 || echo NOT_FOUND",
                                returnStdout: true
                            ).trim()

                            if (!result.contains('NOT_FOUND') &&
                                !result.contains('"items":[]') &&
                                !result.contains('"totalCount":0')) {
                                verified = true
                                echo "Verified: '${params.PROJECT_NAME}' is present in ${params.TARGET_ENV}."
                                break
                            }
                            echo "Attempt ${attempt}/9 — project not yet visible. Waiting 10 seconds..."
                            sleep 10
                        }

                        if (!verified) {
                            error """\
Verification failed: '${params.PROJECT_NAME}' is not visible in ${params.TARGET_ENV} after 90 seconds.
Possible causes:
  1. The import task failed with an encryption error.
     Check: FME Flow UI → Workspace Manager → Import/Export history, or the task log at
     C:\\ProgramData\\Safe Software\\FMEFlow\\resources\\logs\\core\\current\\tasks\\task_<id>.log
     Fix: sync fme_flow_key.jceks from ${params.SOURCE_ENV} to ${params.TARGET_ENV} (see header comment).
  2. The import task is still running (unlikely after 90 s — check the task log).
  3. The project name in the source environment is different from what was uploaded."""
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            sh "rm -f '${env.EXPORT_FILE}'"
        }
        success {
            echo "Promotion complete: '${params.PROJECT_NAME}' is now in ${params.TARGET_ENV}."
        }
        failure {
            echo "Promotion FAILED. See stage logs above for the specific cause and fix."
        }
    }
}

// Returns the FME Flow base URL for the given environment name.
def getEnvUrl(String envName) {
    switch (envName) {
        case 'dev':         return env.DEV_URL
        case 'staging':     return env.STAGING_URL
        case 'prod':        return env.PROD_URL
        case 'cicd-deploy': return env.CICD_DEPLOY_URL
        default:            error "Unknown environment: '${envName}'. Add it to getEnvUrl."
    }
}

// Validates an HTTP response code from a token auth check and fails with a
// self-diagnosing error message rather than letting the failure surface later.
def checkTokenResponse(String code, String envName, String role) {
    if (code == '401') {
        error """\
The ${role} token (dami-fmeflow-${envName}-token) is invalid or expired.
Fix: in FME Flow UI → User Settings → Manage Tokens, delete the token and generate a new one.
     Then update the Jenkins credential with the new token value."""
    }
    if (code == '403') {
        error """\
The ${role} token (dami-fmeflow-${envName}-token) has custom permissions that block project access.
Fix: in FME Flow UI → User Settings → Manage Tokens, delete the token and regenerate it.
     When generating, leave permissions as "inherit from user" — do NOT enable custom permissions."""
    }
    if (code != '200') {
        error "Token check for ${role} environment (${envName}) returned unexpected HTTP ${code}. Check FME Flow Application Server logs."
    }
}
