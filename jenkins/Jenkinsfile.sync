// =============================================================================
// Build 3: FME Flow Project Sync
// =============================================================================
// Promotes an FME Flow Project from one environment to another.
//
// What is an FME Flow Project?
//   A Project is FME Flow's deployment bundle. It contains workspaces,
//   automations, schedules, and connection definitions packaged as a single
//   .fsproject file. Exporting and importing a project is how you move
//   FME work items between environments in a controlled, repeatable way.
//
// What this pipeline does:
//   1. Connects to the source FME Flow environment via the FME Flow REST API
//   2. Downloads the named project as an .fsproject file
//   3. Connects to the target FME Flow environment
//   4. Uploads the .fsproject to the target environment
//   5. Verifies the project appears in the target before finishing
//
// Required Jenkins credentials (one per environment):
//   dami-fmeflow-dev-token     - FME Flow API token for dev
//   dami-fmeflow-staging-token - FME Flow API token for staging
//   dami-fmeflow-prod-token    - FME Flow API token for prod
//   dami-fmeflow-cicd-deploy-token - FME Flow API token for cicd-deploy
//
// How to generate an API token:
//   FME Flow UI → username (top right) → User Settings → Manage Tokens → Generate
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'SOURCE_ENV',
            choices: ['cicd-deploy', 'dev', 'staging'],
            description: 'Environment to export the project FROM. Must be a running FME Flow instance with the project already published.'
        )
        choice(
            name: 'TARGET_ENV',
            choices: ['staging', 'prod', 'cicd-deploy'],
            description: 'Environment to import the project INTO. The project will be created or replaced here.'
        )
        string(
            name: 'PROJECT_NAME',
            defaultValue: '',
            description: 'Exact name of the FME Flow project to promote. Must match the project name in the source environment.'
        )
        booleanParam(
            name: 'OVERWRITE',
            defaultValue: true,
            description: 'Overwrite the project if it already exists in the target environment. Uncheck to fail if the project already exists.'
        )
    }

    environment {
        FME_CLI     = 'fmeflow'
        EXPORT_FILE = "cicd-deploy-${params.PROJECT_NAME ?: 'project'}.fsproject"

        // FME Flow base URLs per environment — update these after each Terraform deployment
        DEV_URL         = 'http://dami-fmeflow-dev-alb-210390386.us-east-1.elb.amazonaws.com'
        STAGING_URL     = 'http://cicd-deploy-staging-alb.us-east-1.elb.amazonaws.com'
        PROD_URL        = 'http://cicd-deploy-prod-alb.us-east-1.elb.amazonaws.com'
        CICD_DEPLOY_URL = 'http://dami-fmeflow-dev-alb-210390386.us-east-1.elb.amazonaws.com'
    }

    stages {

        stage('Validate Parameters') {
            // Checks that the required parameters are provided and make sense
            // before doing anything. Promotes to prod triggers a manual approval
            // gate so accidental promotions cannot happen.
            steps {
                script {
                    if (!params.PROJECT_NAME?.trim()) {
                        error 'PROJECT_NAME is required. Enter the exact name of the FME Flow project to promote.'
                    }
                    if (params.SOURCE_ENV == params.TARGET_ENV) {
                        error "SOURCE_ENV and TARGET_ENV cannot be the same environment (both set to '${params.SOURCE_ENV}')."
                    }
                    if (params.TARGET_ENV == 'prod') {
                        input message: "You are promoting '${params.PROJECT_NAME}' to PRODUCTION from ${params.SOURCE_ENV}. Review the project in ${params.SOURCE_ENV} before continuing.",
                              ok: 'Confirm promotion to prod'
                    }
                    echo "Promoting: '${params.PROJECT_NAME}' from ${params.SOURCE_ENV} → ${params.TARGET_ENV}"
                }
            }
        }

        stage('Setup FME Flow CLI') {
            // Installs the FME Flow CLI (fmeflow-cli) on the Jenkins agent if
            // not already present. The CLI wraps the FME Flow REST API into
            // simple shell commands so we do not have to write raw curl calls.
            // Installation is via pip and takes ~30 seconds on first run.
            steps {
                script {
                    def installed = sh(
                        script: 'fmeflow --version 2>/dev/null && echo OK || echo MISSING',
                        returnStdout: true
                    ).trim()
                    if (installed.contains('MISSING')) {
                        echo 'FME Flow CLI not found. Installing via pip...'
                        sh 'pip3 install fmeflow-cli --quiet'
                        sh 'fmeflow --version'
                        echo 'FME Flow CLI installed.'
                    } else {
                        echo "FME Flow CLI already installed: ${installed}"
                    }
                }
            }
        }

        stage('Export Project from Source') {
            // Authenticates with the source FME Flow environment and downloads
            // the project as an .fsproject file. The .fsproject bundles all
            // project contents: workspaces, automations, schedules, and
            // connection definitions (passwords are excluded for security).
            steps {
                script {
                    def sourceUrl = getEnvUrl(params.SOURCE_ENV)
                    def credId    = "dami-fmeflow-${params.SOURCE_ENV}-token"

                    withCredentials([string(credentialsId: credId, variable: 'FME_TOKEN')]) {
                        echo "Connecting to source: ${params.SOURCE_ENV} (${sourceUrl})"
                        sh "${env.FME_CLI} login ${sourceUrl} --token \$FME_TOKEN"

                        echo "Available projects in ${params.SOURCE_ENV}:"
                        sh "${env.FME_CLI} projects list"

                        echo "Exporting project: '${params.PROJECT_NAME}'"
                        sh "${env.FME_CLI} projects download --name '${params.PROJECT_NAME}' -f '${env.EXPORT_FILE}'"

                        def size = sh(script: "du -sh '${env.EXPORT_FILE}' | cut -f1", returnStdout: true).trim()
                        echo "Export complete. File: ${env.EXPORT_FILE} (${size})"
                    }
                }
            }
        }

        stage('Import Project to Target') {
            // Authenticates with the target FME Flow environment and uploads
            // the .fsproject file. If OVERWRITE is checked, any existing project
            // with the same name in the target will be replaced.
            //
            // Note: Connection passwords are not included in .fsproject files.
            // After the first import into a new environment, re-enter passwords
            // in FME Flow UI → Connections.
            steps {
                script {
                    def targetUrl = getEnvUrl(params.TARGET_ENV)
                    def credId    = "dami-fmeflow-${params.TARGET_ENV}-token"
                    def overwrite = params.OVERWRITE ? '--overwrite' : ''

                    withCredentials([string(credentialsId: credId, variable: 'FME_TOKEN')]) {
                        echo "Connecting to target: ${params.TARGET_ENV} (${targetUrl})"
                        sh "${env.FME_CLI} login ${targetUrl} --token \$FME_TOKEN"

                        echo "Importing project '${params.PROJECT_NAME}' into ${params.TARGET_ENV}..."
                        sh "${env.FME_CLI} projects upload -f '${env.EXPORT_FILE}' ${overwrite}"
                        echo "Import complete."
                    }
                }
            }
        }

        stage('Verify Promotion') {
            // Confirms the project is visible in the target environment after
            // import. Fails the build if the project cannot be found so you
            // know immediately if something went wrong rather than discovering
            // it during a demo or a production job run.
            steps {
                script {
                    def targetUrl = getEnvUrl(params.TARGET_ENV)
                    def credId    = "dami-fmeflow-${params.TARGET_ENV}-token"

                    withCredentials([string(credentialsId: credId, variable: 'FME_TOKEN')]) {
                        sh "${env.FME_CLI} login ${targetUrl} --token \$FME_TOKEN"
                        def result = sh(
                            script: "${env.FME_CLI} projects list | grep -i '${params.PROJECT_NAME}' || echo NOT_FOUND",
                            returnStdout: true
                        ).trim()
                        if (result.contains('NOT_FOUND')) {
                            error "Verification failed: '${params.PROJECT_NAME}' not found in ${params.TARGET_ENV} after import."
                        }
                        echo "Verified: '${params.PROJECT_NAME}' is present in ${params.TARGET_ENV}."
                    }
                }
            }
        }
    }

    post {
        always {
            // Remove the .fsproject file from the Jenkins workspace after the
            // build. It contains workspace source and should not be left on disk.
            sh "rm -f '${env.EXPORT_FILE}'"
        }
        success {
            echo "Build 3 complete: '${params.PROJECT_NAME}' promoted from ${params.SOURCE_ENV} to ${params.TARGET_ENV}."
        }
        failure {
            echo "Build 3 FAILED: promotion of '${params.PROJECT_NAME}' did not complete. Check the stage logs above."
        }
    }
}

// Returns the FME Flow base URL for the given environment name.
def getEnvUrl(String envName) {
    switch (envName) {
        case 'dev':         return env.DEV_URL
        case 'staging':     return env.STAGING_URL
        case 'prod':        return env.PROD_URL
        case 'cicd-deploy': return env.CICD_DEPLOY_URL
        default:            error "Unknown environment: '${envName}'. Add it to the getEnvUrl function."
    }
}
