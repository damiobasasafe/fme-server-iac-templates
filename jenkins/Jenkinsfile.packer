// =============================================================================
// Build 1: FME Flow AMI Builder
// =============================================================================
// Bakes two Windows Server 2022 AMIs using Packer:
//   - Core AMI    : FME Flow installed with /ROLE=Core (the main application server)
//   - Engine AMI  : FME Flow installed with /ROLE=Engine (the processing workers)
//
// Both AMIs have FME Flow pre-installed with all services disabled at bake time.
// Services are configured and started on first instance boot via EC2 user data.
//
// Output: Two AMI IDs published as a Jenkins artifact (ami-ids.env) and passed
//         directly to Build 2 (Terraform) when run as part of the full pipeline.
// =============================================================================

pipeline {
    agent any

    parameters {
        string(
            name: 'FME_INSTALLER_URL',
            defaultValue: 'https://downloads.safe.com/fme/2026/win64/fme-flow-2026.3.1-b26656-win-x64.exe',
            description: 'Direct download URL to the FME Flow Windows installer (.exe). Must be publicly accessible from the Packer build instance.'
        )
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region where AMIs will be built and stored.'
        )
        string(
            name: 'FME_VERSION',
            defaultValue: '2026.3',
            description: 'FME Flow version label used for AMI tagging (e.g. 2026.3). Does not affect which installer is downloaded.'
        )
        string(
            name: 'ENVIRONMENT',
            defaultValue: 'cicd-deploy',
            description: 'Environment name used for AMI tagging (e.g. cicd-deploy, dev, prod).'
        )
        string(
            name: 'VPC_ID',
            defaultValue: '',
            description: 'VPC ID for Packer build instances in the target region. Leave blank to use the DAMI_PACKER_VPC_ID Jenkins global variable (default us-east-1 VPC).'
        )
        string(
            name: 'SUBNET_ID',
            defaultValue: '',
            description: 'Public subnet ID for Packer build instances. Must have internet access so the installer can be downloaded. Leave blank to use the DAMI_PACKER_SUBNET_ID Jenkins global variable.'
        )
    }

    environment {
        PACKER_DIR      = 'AWS/packer'
        PACKER_TEMPLATE = 'fme_flow_aws_windows.pkr.hcl'
        PACKER_LOG      = '1'
    }

    stages {

        stage('Preflight Checks') {
            // Verify all required tools and AWS access are available before
            // starting a build that takes 20+ minutes to run.
            steps {
                script {
                    if (!params.FME_INSTALLER_URL?.trim()) {
                        error 'FME_INSTALLER_URL is required. Provide the direct download URL to the FME Flow Windows installer.'
                    }
                    env.RESOLVED_VPC_ID    = params.VPC_ID?.trim()    ? params.VPC_ID    : env.DAMI_PACKER_VPC_ID
                    env.RESOLVED_SUBNET_ID = params.SUBNET_ID?.trim() ? params.SUBNET_ID : env.DAMI_PACKER_SUBNET_ID
                    if (!env.RESOLVED_VPC_ID?.trim() || !env.RESOLVED_SUBNET_ID?.trim()) {
                        error 'VPC_ID and SUBNET_ID are required. Provide them as parameters or set DAMI_PACKER_VPC_ID and DAMI_PACKER_SUBNET_ID in Jenkins global environment variables.'
                    }
                }
                sh '''
                    echo "=== Tool versions ==="
                    packer version
                    aws --version
                    echo "=== AWS identity ==="
                    aws sts get-caller-identity
                    echo "=== Packer build config ==="
                    echo "Region: $AWS_REGION"
                    echo "VPC:    $RESOLVED_VPC_ID"
                    echo "Subnet: $RESOLVED_SUBNET_ID"
                '''
            }
        }

        stage('Initialise Packer') {
            // Downloads the required Packer plugins (amazon provider).
            // Safe to run every time — plugins are cached after first download.
            steps {
                dir(env.PACKER_DIR) {
                    sh "packer init ${env.PACKER_TEMPLATE}"
                }
            }
        }

        stage('Build AMIs') {
            // Builds Core and Engine AMIs in parallel to save time.
            // Each build launches a temporary EC2 instance, installs FME Flow
            // silently, resets EC2Launch so user data runs on first instance boot,
            // then snapshots the instance into an AMI.
            //
            // Total build time: ~25-35 minutes per AMI (running in parallel).
            parallel {

                stage('Build 1a: Core AMI') {
                    // Core AMI: FME Flow installed with /ROLE=Core
                    // This is the AMI used by the Core Auto Scaling Group.
                    // The Core node runs the FME Flow web application, database
                    // connection, job queue, and engine coordination.
                    steps {
                        dir(env.PACKER_DIR) {
                            sh """
                                set -o pipefail
                                packer build \\
                                    -only='dami-fme-core-windows.amazon-ebs.fme_core_windows' \\
                                    -var 'region=${params.AWS_REGION}' \\
                                    -var 'installer_url=${params.FME_INSTALLER_URL}' \\
                                    -var 'vpc_id=${env.RESOLVED_VPC_ID}' \\
                                    -var 'subnet_id=${env.RESOLVED_SUBNET_ID}' \\
                                    -var 'tags={"Name":"cicd-deploy-fme-core-${params.FME_VERSION}","Version":"${params.FME_VERSION}","Environment":"${params.ENVIRONMENT}","Role":"Core","ManagedBy":"Jenkins-Packer","OS":"Windows-Server-2022"}' \\
                                    ${env.PACKER_TEMPLATE} 2>&1 | tee packer-core.log
                            """
                            script {
                                def log = readFile('packer-core.log')
                                def match = (log =~ /ami-[a-z0-9]{17}/).collect { it }
                                if (match) {
                                    env.CORE_AMI_ID = match.last()
                                    echo "Core AMI ID: ${env.CORE_AMI_ID}"
                                } else {
                                    error 'Could not extract Core AMI ID from Packer output. Check packer-core.log.'
                                }
                            }
                        }
                    }
                }

                stage('Build 1b: Engine AMI') {
                    // Engine AMI: FME Flow installed with /ROLE=Engine
                    // This AMI is used by both the Standard Engine and Dynamic
                    // (CPU-based) Engine Auto Scaling Groups. Engines connect to
                    // the Core node via the NLB on port 7070 to receive jobs.
                    steps {
                        dir(env.PACKER_DIR) {
                            sh """
                                set -o pipefail
                                packer build \\
                                    -only='dami-fme-engine-windows.amazon-ebs.fme_engine_windows' \\
                                    -var 'region=${params.AWS_REGION}' \\
                                    -var 'installer_url=${params.FME_INSTALLER_URL}' \\
                                    -var 'vpc_id=${env.RESOLVED_VPC_ID}' \\
                                    -var 'subnet_id=${env.RESOLVED_SUBNET_ID}' \\
                                    -var 'tags={"Name":"cicd-deploy-fme-engine-${params.FME_VERSION}","Version":"${params.FME_VERSION}","Environment":"${params.ENVIRONMENT}","Role":"Engine","ManagedBy":"Jenkins-Packer","OS":"Windows-Server-2022"}' \\
                                    ${env.PACKER_TEMPLATE} 2>&1 | tee packer-engine.log
                            """
                            script {
                                def log = readFile('packer-engine.log')
                                def match = (log =~ /ami-[a-z0-9]{17}/).collect { it }
                                if (match) {
                                    env.ENGINE_AMI_ID = match.last()
                                    echo "Engine AMI ID: ${env.ENGINE_AMI_ID}"
                                } else {
                                    error 'Could not extract Engine AMI ID from Packer output. Check packer-engine.log.'
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Publish AMI IDs') {
            // Writes the two AMI IDs to a file that Build 2 (Terraform) can
            // consume. Archive it as a Jenkins artifact so it is always
            // retrievable even if the workspace is cleaned between builds.
            steps {
                script {
                    echo "=== AMI Build Summary ==="
                    echo "Core AMI ID:   ${env.CORE_AMI_ID}"
                    echo "Engine AMI ID: ${env.ENGINE_AMI_ID}"
                    echo "FME Version:   ${params.FME_VERSION}"
                    echo "Region:        ${params.AWS_REGION}"
                    echo "Environment:   ${params.ENVIRONMENT}"

                    writeFile file: 'ami-ids.env', text: """CORE_AMI_ID=${env.CORE_AMI_ID}
ENGINE_AMI_ID=${env.ENGINE_AMI_ID}
FME_VERSION=${params.FME_VERSION}
AWS_REGION=${params.AWS_REGION}
ENVIRONMENT=${params.ENVIRONMENT}
BUILD_NUMBER=${env.BUILD_NUMBER}
"""
                }
                archiveArtifacts artifacts: 'ami-ids.env', fingerprint: true
                archiveArtifacts artifacts: 'AWS/packer/packer-*.log', allowEmptyArchive: true
            }
        }
    }

    post {
        success {
            echo "Build 1 complete. Proceed to Build 2 (Terraform) with:"
            echo "  CORE_AMI_ID   = ${env.CORE_AMI_ID}"
            echo "  ENGINE_AMI_ID = ${env.ENGINE_AMI_ID}"
        }
        failure {
            echo 'Build 1 FAILED. Check the packer-*.log artifacts for details.'
            archiveArtifacts artifacts: 'AWS/packer/packer-*.log', allowEmptyArchive: true
        }
    }
}
