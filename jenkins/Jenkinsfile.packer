// Dami - FME Flow Packer AMI Build Pipeline
// Builds FME Core and Engine AMIs (Windows Server 2022) using Packer

pipeline {
    agent any

    parameters {
        string(
            name: 'FME_INSTALLER_URL',
            defaultValue: 'https://downloads.safe.com/fme/2026/win64/fme-flow-2026.3.1-b26656-win-x64.exe',
            description: 'URL to the FME Flow Windows installer (.exe). Required.'
        )
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region to build and publish AMIs in'
        )
        string(
            name: 'FME_VERSION',
            defaultValue: '2026.3',
            description: 'FME Flow version being built (used for tagging)'
        )
    }

    environment {
        PACKER_DIR      = 'AWS/packer'
        PACKER_TEMPLATE = 'fme_flow_aws_windows.pkr.hcl'
        PACKER_LOG      = '1'
        PACKER_LOG_PATH = 'packer-build.log'
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    if (!params.FME_INSTALLER_URL) {
                        error('FME_INSTALLER_URL is required')
                    }
                }
                sh 'packer version'
                sh 'aws sts get-caller-identity'
            }
        }

        stage('Packer Init') {
            steps {
                dir(env.PACKER_DIR) {
                    sh "packer init ${env.PACKER_TEMPLATE}"
                }
            }
        }

        stage('Build AMIs') {
            parallel {
                stage('Build Core AMI') {
                    steps {
                        dir(env.PACKER_DIR) {
                            sh """
                                set -o pipefail
                                packer build \
                                    -only='dami-fme-core-windows.amazon-ebs.fme_core_windows' \
                                    -var 'region=${params.AWS_REGION}' \
                                    -var 'installer_url=${params.FME_INSTALLER_URL}' \
                                    -var 'vpc_id=${env.DAMI_PACKER_VPC_ID}' \
                                    -var 'subnet_id=${env.DAMI_PACKER_SUBNET_ID}' \
                                    -var 'tags={"Name":"dami-fme-core-windows-${params.FME_VERSION}","Version":"${params.FME_VERSION}","ManagedBy":"Dami-CICD","OS":"Windows-Server-2022"}' \
                                    ${env.PACKER_TEMPLATE} | tee packer-core.log
                            """
                            script {
                                def log = readFile('packer-core.log')
                                def amiMatch = log =~ /ami-[a-z0-9]{17}/
                                def amiList = amiMatch.collect { it }
                                if (amiList) {
                                    env.CORE_AMI_ID = amiList[amiList.size() - 1]
                                    echo "Core AMI ID: ${env.CORE_AMI_ID}"
                                } else {
                                    error('Failed to extract Core AMI ID from Packer output')
                                }
                            }
                        }
                    }
                }

                stage('Build Engine AMI') {
                    steps {
                        dir(env.PACKER_DIR) {
                            sh """
                                set -o pipefail
                                packer build \
                                    -only='dami-fme-engine-windows.amazon-ebs.fme_engine_windows' \
                                    -var 'region=${params.AWS_REGION}' \
                                    -var 'installer_url=${params.FME_INSTALLER_URL}' \
                                    -var 'vpc_id=${env.DAMI_PACKER_VPC_ID}' \
                                    -var 'subnet_id=${env.DAMI_PACKER_SUBNET_ID}' \
                                    -var 'tags={"Name":"dami-fme-engine-windows-${params.FME_VERSION}","Version":"${params.FME_VERSION}","ManagedBy":"Dami-CICD","OS":"Windows-Server-2022"}' \
                                    ${env.PACKER_TEMPLATE} | tee packer-engine.log
                            """
                            script {
                                def log = readFile('packer-engine.log')
                                def amiMatch = log =~ /ami-[a-z0-9]{17}/
                                def amiList = amiMatch.collect { it }
                                if (amiList) {
                                    env.ENGINE_AMI_ID = amiList[amiList.size() - 1]
                                    echo "Engine AMI ID: ${env.ENGINE_AMI_ID}"
                                } else {
                                    error('Failed to extract Engine AMI ID from Packer output')
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Publish AMI IDs') {
            steps {
                script {
                    echo "Core AMI:   ${env.CORE_AMI_ID}"
                    echo "Engine AMI: ${env.ENGINE_AMI_ID}"

                    writeFile file: 'ami-ids.env', text: """CORE_AMI_ID=${env.CORE_AMI_ID}
ENGINE_AMI_ID=${env.ENGINE_AMI_ID}
FME_VERSION=${params.FME_VERSION}
AWS_REGION=${params.AWS_REGION}
"""
                }
                archiveArtifacts artifacts: 'ami-ids.env', fingerprint: true
                archiveArtifacts artifacts: 'AWS/packer/packer-*.log', allowEmptyArchive: true
            }
        }
    }

    post {
        failure {
            echo 'Packer build failed. Check packer-*.log for details.'
            archiveArtifacts artifacts: 'AWS/packer/packer-*.log', allowEmptyArchive: true
        }
        success {
            echo "AMI build complete. Core: ${env.CORE_AMI_ID} | Engine: ${env.ENGINE_AMI_ID}"
        }
    }
}
